// bytheslice.config.json: copy this file to your project root and edit.
// All keys are optional; the plugin uses defaults for anything you omit.
// See references/bytheslice-config-schema.md in the ByTheSlice plugin
// for the full schema and precedence rules.
{
  // Override per-agent model tier. Omit any agent to use the plugin default.
  // Aliases: "haiku" | "sonnet" | "opus".
  "modelTiers": {
    // "implementer": "opus",
    // "qualityReviewer": "opus",
    // "sliceTester": "sonnet",
    // "sliceVerifier": "sonnet"
  },

  // Per-stage shape preferences.
  "stages": {
    // "maxTasksPerStage": 6,
    // "targetFeatureStages": "20-30"     // default: a ceiling for large apps, never padding; a small brief gets few pies.
                                         // Any other band (e.g. "10-15") is an override the count must land in.
  },

  // Verification knobs for sell-slice Workflow B / sell-pie per-slice loop.
  "verification": {
    // "viewports": [375, 768, 1280],       // widths the slice-tester renders at (C7); screenshots only at 768 and 1280
    // "e2e": {
    //   "feature": "always",              // "always" | "critical-only" | "off"
    //   "regressionCore": "critical-only",
    //   "visual": "off"
    // }
  },

  // HITL-collapse flow knobs for sell-slice / sell-pie.
  "flow": {
    // "autoApproveBuildPlan": false,        // always auto under the /sell-pie loop
    // "libraryGate": "self-critique"        // "self-critique" | "human" | "off"
  },

  // Default review sensitivity for pies missing a `<!-- review: ... -->` annotation.
  "review": {
    // "default": "boundary"                 // "boundary" | "continuous"
  },

  // How finished slices reach main, plus the soft per-slice time budget.
  "delivery": {
    // "mode": "pie-pr",                     // "pie-pr" (one PR per pie) | "merge-per-slice" (one PR per slice, merged on green CI) | "ship-once" (local gates, one PR for the app)
    // "sliceBudgetHours": 3,                // soft per-slice wall-clock budget; 0 = off
    // "shipBranch": "ship/my-app"           // ship-once only
  },

  // Test and CI scaffold size: "standard" | "lean" (lint, typecheck, unit, build, one smoke spec) | "auto".
  "quality": {
    // "tier": "standard"
  },

  // Your own shadcn-style registries, searched before stock shadcn. See the schema doc for the entry shape.
  "ui": {
    // "registries": [],
    // "registryFirst": true
  },

  // Unattended runs decide, record and continue instead of asking. /pizza-party sets this.
  "run": {
    // "unattended": false
  },

  // Declare which MCPs the project has installed.
  // The plugin reads this in addition to the project rules file.
  "mcps": {
    // "shadcn": true,
    // "magic": false,
    // "figma": false,
    // "chromeDevTools": true,
    // "supabase": false
  },

  // Visual review tooling priority.
  "visualReview": {
    // "tools": ["claude-in-chrome", "chrome-devtools-mcp", "playwright"],
    // "vizzly": false
  },

  // Add project-specific HITL categories beyond the four built-in.
  "hitl": {
    "additionalCategories": [
      // { "name": "legal_review", "promptHint": "Legal sign-off needed before this lands." }
    ]
  },

  // External rule-file imports (skips cook-pizzas elicitation Q9 when non-empty).
  "rules": {
    "imports": [
      // "https://github.com/your-org/agentic-rules/blob/main/monorepo-nextjs/CLAUDE.md"
    ]
  },

  // Bootstrap defaults, used by /bytheslice:setup-shop.
  "bootstrap": {
    // "variant": "single-app",
    // "stack": "nextjs",
    // "roadmapFile": "ROADMAP.local.md"
  }
}
